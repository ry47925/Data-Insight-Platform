# ============================================
# 数据洞察平台 - 环境变量配置模板
# 复制此文件为 .env 并修改对应值
# ============================================

# ------------------- 数据库配置 -------------------
# 平台强制使用 PostgreSQL，SQLite 已完全废弃（config.py 启动时会校验并拒绝 SQLite）
# 开发/生产环境均使用 PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/data_insight

# 连接池配置（仅PostgreSQL生效）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ------------------- JWT配置 -------------------
SECRET_KEY=your-secret-key-change-in-production

# ------------------- 管理员配置 -------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ------------------- AI服务配置 -------------------
# DeepSeek API Key（使用OpenAI SDK兼容模式调用）
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ------------------- 文件存储配置（可选）-------------------
# 默认使用项目目录下的 data/uploads，如需自定义可取消注释
# UPLOAD_DIR=/path/to/uploads
# TRASH_DIR=/path/to/trash
# DATA_DIR=/path/to/data
# MODELS_DIR=/path/to/models

# ------------------- Redis缓存配置 -------------------
# 开发环境：不启用（默认）
REDIS_ENABLED=false

# 生产环境：启用并配置Redis连接
# REDIS_ENABLED=true
# REDIS_URL=redis://:your-redis-password@localhost:6379/0
# REDIS_TTL=3600

# ------------------- ClickHouse配置 -------------------
# 开发环境：不启用（默认）
CLICKHOUSE_ENABLED=false

# 生产环境：启用并配置连接信息
# CLICKHOUSE_ENABLED=true
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=analysis

# ------------------- Celery异步任务配置 -------------------
# config.py 中默认启用 Celery（true），已接入 ML 训练/清洗/特征工程异步化
# 如需显式关闭，可设为 false
CELERY_ENABLED=true

# 生产环境：启用并配置Redis作为消息队列
# CELERY_ENABLED=true
# CELERY_BROKER_URL=redis://:your-redis-password@localhost:6379/1
# CELERY_RESULT_BACKEND=redis://:your-redis-password@localhost:6379/2

# ------------------- 异步任务参数配置（v3 新增，全部收口到 config.py）-------------------
# 以下参数控制异步任务的触发阈值、并发数、超时等，修改只需改 .env 无需改代码

# 异步触发阈值：数据集行数 >= 此值时走异步（Celery），否则同步执行
# 开发阶段可用较小值（如 1000）测试异步链路，生产环境建议保持 10000
ASYNC_THRESHOLD=10000

# Celery Worker 并发数：同时执行的任务数
# 注：此变量仅由 docker-compose.yml 插值使用（--concurrency 命令行参数），config.py 不读取
# 开发环境建议 2（避免本机资源争抢），生产环境可根据 CPU 核数调整
CELERY_CONCURRENCY=2

# 任务硬超时（秒）：超时后 Worker 强制终止任务进程
CELERY_TASK_TIME_LIMIT=1800

# 任务软超时（秒）：超时后向任务抛 SoftTimeLimitExceeded
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Worker 预取倍数：每次只预取 1 个任务，避免长任务占用预取槽位
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ------------------- MinIO对象存储配置 -------------------
# MinIO 为必需组件（无本地文件系统降级），无需开关，配置连接信息即可
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=data-insight
MINIO_SECURE=false